<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <SupportedOSPlatform>Windows</SupportedOSPlatform>
    <NoWarn>$(NoWarn);CA1416;CS0414</NoWarn>
    <Version>0.1.29</Version>
    <AssemblyVersion>0.1.29</AssemblyVersion>
    <FileVersion>0.1.29</FileVersion>
    <ModType>mod</ModType>
    <ModMain>DeadCellsLocalMultiplayerMod.ModEntry</ModMain>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>DeadCellsLocalMultiplayerMod</AssemblyName>
    <!-- Debug builds auto-install the mod into the DCCM layout (coremod\mods\) for quick iteration. -->
    <AutoInstallMod Condition="'$(Configuration)' == 'Debug'">true</AutoInstallMod>
    <GenerateSinglePakFile>true</GenerateSinglePakFile>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The /dccm folder holds a gitignored decompiled dump of the game assemblies, used only for
         reading the game source (the real dc.* types resolve from the MDK package's reference
         assemblies). It is not valid C#, so it must never be picked up by the SDK's default compile
         glob, or the build fails with ~10k syntax errors. -->
    <Compile Remove="dccm\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .mo language catalogs are generated from Resourcefile/lang/main.zh.po by
         Tools/gen_mo.py and are gitignored (never committed), so a clean checkout has none on
         disk. They are generated before the build runs: build.ps1 does it locally and the CI
         workflow does it in its own step. The packed res.pak therefore always reflects the .po
         sources, and a stale binary can never be committed. -->
    <PackAssets Include="Resourcefile\**\*" RootInPak="DeadCellsLocalMultiplayerModLang" />
  </ItemGroup>
</Project>
